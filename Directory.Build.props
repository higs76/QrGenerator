  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Authors>Higs76</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Assemblies de référence .NET Framework (remplace le pack de ciblage) : utilisé au build seulement. -->
